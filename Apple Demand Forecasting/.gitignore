# Notebook outputs that bloat the repo (use jupyter nbconvert --clear-output before commit)
notebooks/*-checkpoint.ipynb

# Note: data/processed/forecasts/ contents are committed despite being
# regenerable, so a reviewer can see the output without running the pipeline.
# The SQLite DB itself stays gitignored — it's larger and generates from
# `python scripts/build_database.py` in seconds.

# Tableau workbook lock files
*.twb.lock
*.twbx.lock
